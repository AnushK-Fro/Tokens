# ---- docker compose (docker-compose.yml) ----
# Public hostname Caddy serves (and gets a certificate for). DNS must point at this machine.
TOKENS_HOST=tokens.anush.me
# MariaDB password for the `tokens` user. Generate with: openssl rand -hex 24 (hex keeps it URL-safe).
DB_PASSWORD=
# Optional: host ports for Caddy, if 80/443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- shared ----
# Bearer key sync clients send to POST /api/ingest. Generate with: openssl rand -hex 32
INGEST_TOKEN=
# Zone sync clients and imports count days in; the dashboard shows each viewer's own zone where
# per-request events allow and falls back to this one.
TOKEN_USAGE_TIMEZONE=UTC

# ---- running without docker (cargo run) ----
# Compose sets these itself; they're only read when running the binary directly.
DATABASE_URL=mysql://tokens:change-me@localhost:3306/tokens
BIND=127.0.0.1:8787
